# Docker
.dockerignore.bak
docker-compose.override.yml

# Kubernetes secrets
k8s/secrets/

# `make stack-up` generates a keystore and a Prometheus scrape token here. keys.json holds only
# SHA-256 hashes, not the keys themselves, but it is still an inventory of who has access — and a
# path that is easy to commit by accident is a path that eventually is.
secrets/
*.kubeconfig

# Terraform
*.tfstate
*.tfstate.backup
.terraform/
*.tfvars
.terraform.lock.hcl

