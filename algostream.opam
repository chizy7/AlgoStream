opam-version: "2.0"
synopsis:
  "High-performance algorithmic trading platform with statistical arbitrage"
description:
  "AlgoStream is a production-grade algorithmic trading system built with OCaml, featuring sub-5ms execution latency, statistical arbitrage capabilities, Monte Carlo backtesting with 10,000+ simulations, and processing 50,000+ market events per second. Designed for quantitative trading with advanced risk management and real-time analytics."
maintainer: ["Chizaram Chibueze <chizy@chizyhub.com>"]
authors: ["Chizaram Chibueze <chizy@chizyhub.com>"]
license: "MIT"
homepage: "https://github.com/chizy7/AlgoStream"
doc: "https://github.com/chizy7/AlgoStream"
bug-reports: "https://github.com/chizy7/AlgoStream/issues"
depends: [
  "ocaml" {>= "5.0.0"}
  "dune" {>= "3.16"}
  "lwt" {>= "5.7.0"}
  "cohttp-lwt-unix" {>= "5.0.0"}
  "conduit-lwt-unix" {>= "6.2.0"}
  "base" {>= "v0.16.0"}
  "stdio" {>= "v0.16.0"}
  "yojson" {>= "2.0.0"}
  "bin_prot" {>= "v0.16.0"}
  "ppx_bin_prot" {>= "v0.16.0"}
  "ppx_jane" {>= "v0.16.0"}
  "websocket-lwt-unix" {>= "2.16"}
  "tls-lwt" {>= "0.17.0"}
  "uri" {>= "4.4.0"}
  "logs" {>= "0.7.0"}
  "digestif" {>= "1.1.0"}
  "mirage-crypto-rng" {>= "1.0.0"}
  "ipaddr" {>= "5.0.0"}
  "memtrace" {>= "0.2.3"}
  "re" {>= "1.10.0"}
  "alcotest" {with-test}
  "ocaml-lsp-server" {with-dev-setup}
  "ocamlformat" {with-dev-setup & = "0.27.0"}
  "utop" {with-dev-setup}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/chizy7/AlgoStream.git"
